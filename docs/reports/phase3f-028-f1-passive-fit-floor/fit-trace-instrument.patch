new file mode 100644
index 0000000..2f1d1eb
--- /dev/null
+++ b/internal/tui/scratch_fittrace.go
@@ -0,0 +1,35 @@
+package tui
+
+// SCRATCH INSTRUMENT (task 028 derivation only) -- never committed.
+
+import (
+	"fmt"
+	"os"
+	"sync"
+	"time"
+)
+
+var (
+	fitTraceMu   sync.Mutex
+	fitTraceFile *os.File
+	fitTraceOnce sync.Once
+)
+
+func fitTrace(format string, args ...any) {
+	path := os.Getenv("DECK_FIT_TRACE")
+	if path == "" {
+		return
+	}
+	fitTraceOnce.Do(func() {
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+		if err == nil {
+			fitTraceFile = f
+		}
+	})
+	if fitTraceFile == nil {
+		return
+	}
+	fitTraceMu.Lock()
+	defer fitTraceMu.Unlock()
+	fmt.Fprintf(fitTraceFile, "%d pid=%d %s\n", time.Now().UnixNano()/1e6, os.Getpid(), fmt.Sprintf(format, args...))
+}
