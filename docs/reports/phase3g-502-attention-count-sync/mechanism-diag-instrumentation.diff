+// diagStatusDump is scratch-tree-only diagnostic instrumentation for task
+// 502's mechanism evidence. NEVER committed.
+func diagStatusDump(ctx context.Context) string {
+	h, err := assertionHarness(ctx)
+	if err != nil {
+		return "harness: " + err.Error()
+	}
+	db, err := openObservedDatabase(h)
+	if err != nil {
+		return "open: " + err.Error()
+	}
+	defer db.Close()
+	rows, err := db.QueryContext(ctx, `SELECT name, status, status_source, status_reason, status_at FROM sessions ORDER BY name`)
+	if err != nil {
+		return "query: " + err.Error()
+	}
+	defer rows.Close()
+	var b strings.Builder
+	for rows.Next() {
+		var name, status, source string
+		var reason *string
+		var at int64
+		if err := rows.Scan(&name, &status, &source, &reason, &at); err != nil {
+			return "scan: " + err.Error()
+		}
+		r := ""
+		if reason != nil {
+			r = *reason
+		}
+		fmt.Fprintf(&b, "  %s|%s|%s|%s|%d\n", name, status, source, r, at)
+	}
+	return b.String()
+}
