// deck releases on the homelab Jenkins: pipeline job deck/release, started by
// hand, running this file from main (see docs/ci.md, "Release").
//
// It releases exactly the commit that a green deck/ci main build recorded in
// ci-results/release-candidate.json (the last fully green one, or CI_BUILD):
// Candidate -> Checkout -> Version check -> Build -> Publish. The release is
// created as a draft with every asset attached and only then published, so
// GitHub's immutable-releases setting (which freezes a release at
// publication) never sees a half-populated release; the tag is created on
// GitHub at the candidate commit when the draft is published. Nothing is ever
// pushed from the agent. Publish then checks the release is immutable, which
// deck update requires by default. DRY_RUN stops before publishing. Every result posts a Telegram message (notifyTelegram, from
// the homelab shared library github.com/n-orlov/jenkins-library).
@Library('homelab') _

pipeline {
  agent { label 'linux && amd64 && docker' }

  options {
    ansiColor('xterm')
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '50'))
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    skipDefaultCheckout()                 // the Checkout stage, once the commit is known
  }

  parameters {
    string(name: 'VERSION', defaultValue: '', trim: true,
           description: 'Release version, e.g. v1.4.0 or v1.5.0-rc.1 (required; the tag must not exist yet)')
    string(name: 'CI_BUILD', defaultValue: '', trim: true,
           description: 'deck/ci main build number to release; empty = the last successful one')
    booleanParam(name: 'DRY_RUN', defaultValue: false,
                 description: 'Build and archive the release, but do not publish it')
  }

  environment {
    DECK_CI_OUT = 'ci-results'
    DECK_CI_CACHE_VOLUME = 'deck-go-cache-jenkins'
    CANDIDATE = 'candidate/ci-results/release-candidate.json'
  }

  stages {
    // Which commit: the release candidate of a green deck/ci main build. A
    // build that was not green has none, so the copy fails.
    stage('Candidate') {
      steps {
        script {
          if (!(params.VERSION ==~ /^v\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$/)) {
            error('VERSION "' + params.VERSION + '" is not vMAJOR.MINOR.PATCH[-pre]')
          }
          currentBuild.displayName = params.VERSION + (params.DRY_RUN ? ' (dry run)' : '')
          if (params.CI_BUILD && !(params.CI_BUILD ==~ /^[0-9]+$/)) {
            error('CI_BUILD "' + params.CI_BUILD + '" is not a build number')
          }
        }
        sh 'rm -rf candidate'
        script {
          try {
            copyArtifacts projectName: '/deck/ci/main', filter: 'ci-results/release-candidate.json',
                          target: 'candidate', fingerprintArtifacts: true,
                          selector: params.CI_BUILD ? specific(params.CI_BUILD) : lastSuccessful(stable: true)
          } catch (err) {
            error('no release candidate in deck/ci main ' + (params.CI_BUILD ? '#' + params.CI_BUILD : 'last successful build') +
                  ': only a fully green main build is releasable (' + err.getMessage() + ')')
          }
          env.RELEASE_SHA = sh(returnStdout: true, script: '''
            python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["commit"])' "$CANDIDATE"
          ''').trim()
          env.CI_BUILD_URL = sh(returnStdout: true, script: '''
            python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["build_url"])' "$CANDIDATE"
          ''').trim()
          if (!(env.RELEASE_SHA ==~ /^[0-9a-f]{40}$/)) {
            error('release candidate commit "' + env.RELEASE_SHA + '" is not a full sha')
          }
          echo 'Releasing ' + env.RELEASE_SHA + ' from ' + env.CI_BUILD_URL
        }
      }
    }

    // The candidate commit is on main (deck/ci/main built it); this checkout
    // of main has it in its history.
    stage('Checkout') {
      steps {
        checkout scm
        sh '''
          git clean -ffdxq
          git merge-base --is-ancestor "$RELEASE_SHA" HEAD || {
            echo "$RELEASE_SHA is not on main" >&2; exit 1; }
          git checkout --quiet --detach "$RELEASE_SHA"
        '''
      }
    }

    // The tag must not exist yet: ls-remote exits 2 when nothing matches, 0
    // when the tag exists, anything else when GitHub cannot be asked. The
    // repository's immutable-releases setting must be on: deck update refuses
    // a release GitHub does not report immutable, so publishing without it
    // would ship a release nobody can update to.
    stage('Version check') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-n-orlov',
                                          usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh '''
            export GIT_TERMINAL_PROMPT=0
            rc=0
            git ls-remote --exit-code --tags "https://${GH_USER}:${GH_TOKEN}@github.com/n-orlov/deck.git" \
              "refs/tags/$VERSION" >/dev/null || rc=$?
            case $rc in
              2) echo "$VERSION is a new tag" ;;
              0) echo "tag $VERSION already exists on GitHub; not releasing" >&2; exit 1 ;;
              *) echo "could not list the tags on GitHub (exit $rc); not releasing" >&2; exit 1 ;;
            esac
            export GH_PROMPT_DISABLED=1
            enabled=$(gh api repos/n-orlov/deck/immutable-releases --jq .enabled 2>/dev/null) || enabled=unknown
            if [ "$enabled" != true ]; then
              echo "immutable releases are not enabled on n-orlov/deck (answer: $enabled); deck update would refuse this release. Enable them in the repository settings; not releasing" >&2
              exit 1
            fi
            echo "immutable releases are enabled on n-orlov/deck"
          '''
        }
      }
    }

    // The four archives and checksums.txt, built in the CI image from the
    // candidate commit, with the deck --version smoke check.
    stage('Build') {
      steps {
        sh 'ci/jenkins-image.sh'
        sh 'ci/run.sh ci/release-build.sh "$VERSION"'
      }
    }

    // Draft first, then publish: with immutable releases on, a release is
    // frozen the moment it is published, so every asset is attached to the
    // draft before that. The draft is published through its id (a draft has
    // no tag yet, so it cannot be looked up by one); publishing creates the
    // tag at the candidate commit. A -pre version is a prerelease and never
    // becomes "latest". Then the published release must be immutable, with
    // every asset, or the build fails.
    stage('Publish') {
      when { expression { !params.DRY_RUN } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-n-orlov',
                                          usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          script {
            env.RELEASE_URL = sh(returnStdout: true, script: '''
              export GH_PROMPT_DISABLED=1 GIT_TERMINAL_PROMPT=0
              case "$VERSION" in
                *-*) pre=--prerelease latest=false ;;
                *)   pre= latest=true ;;
              esac
              gh release create "$VERSION" dist/* --repo n-orlov/deck --target "$RELEASE_SHA" \
                --title "$VERSION" --generate-notes --draft $pre >&2
              id=$(gh api 'repos/n-orlov/deck/releases?per_page=100' \
                --jq '.[] | select(.draft and .tag_name == env.VERSION) | .id')
              case "$id" in
                ''|*[!0-9]*) echo "cannot find the one draft release for $VERSION (got: $id)" >&2; exit 1 ;;
              esac
              gh api --method PATCH "repos/n-orlov/deck/releases/$id" \
                -F draft=false -f make_latest="$latest" --jq .html_url
            ''').trim()
          }
          sh '''
            export GH_PROMPT_DISABLED=1
            want="false|true|$(ls dist | LC_ALL=C sort | paste -sd ' ' -)"
            for try in 1 2 3; do
              rel=$(gh api "repos/n-orlov/deck/releases/tags/$VERSION" \
                --jq '[.draft, .immutable, ([.assets[].name] | sort | join(" "))] | map(tostring) | join("|")') || rel=
              [ "$rel" = "$want" ] && break
              sleep 5
            done
            if [ "$rel" != "$want" ]; then
              echo "published $VERSION is not an immutable release with every asset: got [$rel], want [$want]" >&2
              exit 1
            fi
            echo "published $VERSION: immutable, with every asset"
          '''
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'dist/*', allowEmptyArchive: true, fingerprint: true
      script {
        if (env.RELEASE_SHA) {
          def text = params.VERSION + ' from ' + env.RELEASE_SHA +
                     ' (<a href="' + env.CI_BUILD_URL + '">CI build</a>)'
          if (env.RELEASE_URL) {
            text += ': <a href="' + env.RELEASE_URL + '">GitHub release</a>'
          } else if (params.DRY_RUN) {
            text += ': dry run, not published'
          } else {
            text += ': not published'
          }
          addSummary(icon: currentBuild.currentResult == 'SUCCESS' ? 'symbol-checkmark-circle-outline plugin-ionicons-api'
                                                                   : 'symbol-close-circle-outline plugin-ionicons-api',
                     text: text)
        }
      }
    }
    cleanup {
      script {
        def note = env.RELEASE_URL ? 'GitHub release: ' + env.RELEASE_URL
                 : params.DRY_RUN ? 'dry run, not published' : 'not published'
        notifyTelegram(notifyOn: 'ALL', silent: false, title: 'deck release ' + params.VERSION,
                       commit: env.RELEASE_SHA, extra: note)
      }
    }
  }
}
